# AN_DOMINIO: el dominio público (Caddy pide y renueva el certificado solo). Con `localhost` usa su CA interna.
{$AN_DOMINIO:localhost} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	# La API ya pone sus cabeceras a /api/*; esto cubre el front estático. El front usa estilos en línea (style=…), de ahí 'unsafe-inline' solo en style-src.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
		defer
	}
	@estatico not path /api/*
	header @estatico Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	log {
		output stdout
	}
}
