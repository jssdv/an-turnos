# AN_DOMINIO: el dominio público (Caddy pide y renueva el certificado solo). Con `localhost` usa su CA interna.
{$AN_DOMINIO:localhost} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	header Strict-Transport-Security "max-age=31536000"
	log {
		output stdout
	}
}
