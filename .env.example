# Copia a `.env` (no se versiona) y reemplaza cada CAMBIAR_… . Genera claves con: openssl rand -hex 24
AN_DOMINIO=localhost                  # dominio público; en el servidor real, p. ej. turnos.miclinica.co (DNS ya apuntado)
AN_PUERTO_HTTP=80
AN_PUERTO_HTTPS=443
AN_ADMIN_CLAVE=CAMBIAR_clave_del_rol_dueno      # rol `an_admin`: migra y administra; nunca lo usa la API
AN_APP_CLAVE=CAMBIAR_clave_de_an_app            # rol `an_app`: lo que usan la API y el trabajador (solo letras y números)
AN_SOLVER_WORKERS=4                   # hilos de CP-SAT; vCPU del servidor
AN_RESPALDO_DESTINO=./respaldos       # carpeta (en el servidor) donde cae el respaldo cifrado; copiarla fuera es parte de la operación
AN_RESPALDO_RECIPIENTS=./deploy/respaldo.recipients  # archivo con la(s) clave(s) PÚBLICA(S) age; la privada no va en el servidor
AN_RESPALDO_FIRMA=./deploy/respaldo.firma.key  # clave PRIVADA de firma (ssh-keygen, sin frase, chmod 600); distinta de la de cifrado; la pública va al equipo de confianza
AN_RESPALDO_DIAS=30                   # días que se conservan los respaldos
# Solo para pruebas locales con puertos distintos de 80/443 (la API compara el Origin con esto):
# AN_PUERTO_HTTPS=8443
# AN_ORIGEN_PUERTO=:8443
